# Vercel builds this into a container Function. Python 3.11 because DeepFilterLib ships no newer wheels.
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*  # df.utils calls git at import
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY server.py models.py ./
COPY models ./models
COPY static ./static
# bake all model weights into the image so cold starts never download
RUN python -c "import models, dpdfnet; [dpdfnet.download(m) for m in ('dpdfnet2', 'dpdfnet2_8khz', 'dpdfnet2_48khz_hr')]"
CMD uvicorn server:app --host 0.0.0.0 --port ${PORT:-80}
