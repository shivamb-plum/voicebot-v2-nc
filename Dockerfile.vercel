# Vercel builds this into a container Function. Python 3.11 because DeepFilterLib ships no newer wheels.
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
# bake the DeepFilterNet3 weights into the image so cold starts don't hit GitHub
RUN python -c "from df.enhance import init_df; init_df(log_level='WARNING')"
COPY server.py ./
COPY static ./static
CMD uvicorn server:app --host 0.0.0.0 --port ${PORT:-80}
